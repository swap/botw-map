{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BOTW Map",
  "version": "0.1.0",
  "identifier": "com.sa1nt.botw-map",
  "build": {
    "beforeDevCommand": "npm run unpack && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run unpack && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BOTW Map",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis", "msi"],
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
